---
import { site } from '../../config/site';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="wordmark" aria-label="Wyllex home">
          wyllex
          <span class="brand-star" aria-hidden="true">
            ✳
          </span>
        </a>
        <p>Law worth scrolling.</p>
      </div>
      <nav class="footer-links" aria-label="Footer navigation">
        <a href="/#product">Product</a>
        <a href="/#subjects">Subjects</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href={`mailto:${site.contactEmail}`}>Contact</a>
        {site.socialLinks.map((link) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        ))}
        {site.posthog.key && (
          <button id="privacy-settings" type="button">
            Privacy choices
          </button>
        )}
      </nav>
    </div>
    <div class="footer-bottom">
      <span>
        © {new Date().getFullYear()} {site.name}. All rights reserved.
      </span>
      <span>
        Made for curious minds. <span aria-hidden="true">✳</span>
      </span>
    </div>
  </div>
</footer>
<script>
  document
    .getElementById('privacy-settings')
    ?.addEventListener('click', () => window.dispatchEvent(new Event('wyllex:privacy-settings')));
</script>
